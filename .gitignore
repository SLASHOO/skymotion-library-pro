# Secrets — never commit Bunny (or any) credentials.
.env
.env.*
# …but DO track the secret-free example.
!.env.local.example

# Generated release manifests — regenerated by deploy/release-*.mjs on every
# release (the live source of truth is the copy on Bunny, not git). Tracking
# them dirties the tree between releases and blocks the clean-repo guard.
boot/library-release.json
boot/home-release.json

.venv/
.idea/workspace.xml
.idea/shelf/
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
__pycache__/
*.pyc
.DS_Store
.idea/

# Local dev-server config (per-machine, not product code).
.claude/launch.json

# Codex CLI tool state (not part of this product).
.codex/