# Bunny credentials for deploy/release-library.mjs
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.
# Only the PRESENCE of each var is ever printed by the release script — never the value.

# Storage zone name (Bunny dashboard -> Storage -> your zone -> name)
BUNNY_STORAGE_ZONE=

# Storage zone password / write access key (Storage -> your zone -> FTP & API Access -> Password)
BUNNY_STORAGE_PASSWORD=

# Account API key, used ONLY to purge the manifest URL (Account Settings -> API -> API Key)
BUNNY_PURGE_API_KEY=

# Optional: storage endpoint host. Leave unset to use the global endpoint.
# Set only if your storage zone is pinned to a region, e.g. ny.storage.bunnycdn.com
# BUNNY_STORAGE_HOST=
